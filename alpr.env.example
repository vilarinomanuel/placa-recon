# ---------------------------------------------------------------------------
# Configuración de alpr_stream.py — EnvironmentFile de systemd
#
# PLANTILLA — cópiala como /etc/alpr/alpr.env y edítala allí. NO la versiones con datos reales.
# Ubicación recomendada:  /etc/alpr/alpr.env
# Permisos OBLIGATORIOS (contiene la contraseña de la cámara):
#   sudo install -d -m 0750 -o root -g alpr /etc/alpr
#   sudo install -m 0640 -o root -g alpr alpr.env.example /etc/alpr/alpr.env
#
# Formato systemd: KEY=VALOR, sin `export`, sin comillas salvo que el valor
# contenga espacios, sin expansión de variables de shell.
# Si la contraseña contiene @ : / ? # % debes codificarla en percent-encoding
# (@ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25).
# ---------------------------------------------------------------------------

# --- Fuente (obligatoria) --------------------------------------------------
# RTSP:   rtsp://usuario:clave@192.168.1.50:554/Streaming/Channels/101
# Webcam: 0
# Archivo: /var/lib/alpr/video/entrada.mp4
ALPR_INPUT=rtsp://admin:CAMBIAME@192.168.1.50:554/Streaming/Channels/101

# --- Salidas ---------------------------------------------------------------
ALPR_CSV=/var/lib/alpr/placas.csv
ALPR_OUTPUT=/var/lib/alpr/video/acceso.mp4
ALPR_SEGMENT_MINUTES=10
ALPR_FOURCC=mp4v
# ALPR_NO_VIDEO=true          # solo CSV + recortes, sin grabar video
ALPR_HUD=true

# --- Imágenes individuales de placas --------------------------------------
ALPR_SAVE_CROPS=true
ALPR_CROPS_DIR=/var/lib/alpr/crops
ALPR_CROP_MARGIN=0.15
ALPR_JPEG_QUALITY=92
ALPR_CROP_MIN_SIZE=24
ALPR_SAVE_FULL_FRAME=true
ALPR_CROPS_BY_PLATE=false
# ALPR_SAVE_ALL_CROPS=false   # true = guarda cada detección, ignora el dedup

# --- Vista en vivo para el panel web ---------------------------------------
# El motor publica el último fotograma anotado como JPEG; el panel lo muestra
# en una ventana pequeña. Déjalo vacío para desactivar la vista.
ALPR_LIVE_VIEW=/var/lib/alpr/live/acceso.jpg
ALPR_LIVE_VIEW_FPS=3
ALPR_LIVE_VIEW_WIDTH=640
ALPR_LIVE_VIEW_QUALITY=70

# --- Detección -------------------------------------------------------------
ALPR_MIN_CONFIDENCE=0.8
ALPR_DEDUP_WINDOW=5
ALPR_DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end
ALPR_OCR_MODEL=cct-xs-v1-global-model

# --- Tiempo real -----------------------------------------------------------
ALPR_TARGET_FPS=5
ALPR_RTSP_TRANSPORT=tcp
ALPR_RTSP_TIMEOUT=10
ALPR_KEEP_RECORDING_OFFLINE=true
# ALPR_DURATION=0             # 0 = servicio indefinido
# ALPR_LIVE=true              # forzar modo vivo si la URL no lo delata

# --- Selección de fuente (multiplataforma) ---------------------------------
# En el servicio la fuente SIEMPRE se define aquí (ALPR_INPUT): el menú
# interactivo solo aplica cuando se ejecuta a mano en un PC con consola.
# ALPR_SELECT_SOURCE=false      # true = forzar menú (no usar en systemd)
# ALPR_SCAN_IP_CAMERAS=false    # buscar cámaras IP en la LAN al detectar
# ALPR_NO_PREVIEW=true          # no ofrecer vista previa
# ALPR_ANDROID_CAMERA_ID=0      # Android: forzar id de cámara (0 = trasera)
# ALPR_FORCE_PLATFORM=android   # solo para pruebas de la detección
# ALPR_NO_GUI=1                 # nunca abrir ventanas ni explorador gráfico

# --- Runtime ---------------------------------------------------------------
ALPR_VERBOSE=false
# Caché de modelos ONNX (debe ser escribible por el usuario del servicio)
HOME=/var/lib/alpr
XDG_CACHE_HOME=/var/lib/alpr/.cache
# Limita hilos de ONNX/OpenCV en equipos pequeños
OMP_NUM_THREADS=2
OPENCV_FFMPEG_LOGLEVEL=16
