# ---------------------------------------------------------------------------
# placa-recon · configuración del panel web (Windows)
# Copia este archivo a C:\alpr\config\panel.env y ajústalo.
# Lo lee iniciar-panel.ps1 y lo inyecta como variables de entorno del proceso.
# No lleva credenciales de cámara: esas van en config\<id>.env o en el panel.
#
# Estructura única (raíz C:\alpr). Si cambias la raíz, cambia todas estas rutas
# o borra las líneas y define solo ALPR_HOME: el panel deriva el resto.
#   C:\alpr\                  código, venv\
#   C:\alpr\config\           panel.env, alpr.env, <id>.env
#   C:\alpr\datos\            placas.csv, camaras.json
#   C:\alpr\datos\crops\      recortes y frames completos
#   C:\alpr\datos\video\      <id>.mp4 anotado por cámara
#   C:\alpr\datos\live\       <id>.jpg de la vista en vivo
#   C:\alpr\datos\logs\       <id>.log por cámara + panel.*.log
#   C:\alpr\datos\run\        <id>.pid.json del supervisor
#   C:\alpr\respaldo\         copias previas a cada actualización
# ---------------------------------------------------------------------------

# --- Raíz de la instalación
ALPR_HOME=C:\alpr

# --- Rutas (todas derivan de la raíz; se listan explícitas para poder moverlas)
ALPR_WEB_DATA=C:\alpr\datos
ALPR_WEB_CSV=C:\alpr\datos\placas.csv
ALPR_WEB_CAMERAS=C:\alpr\datos\camaras.json
ALPR_WEB_CONFIG=C:\alpr\config
ALPR_WEB_CROPS=C:\alpr\datos\crops
ALPR_WEB_VIDEO=C:\alpr\datos\video
ALPR_WEB_LOGS=C:\alpr\datos\logs
ALPR_WEB_RUN=C:\alpr\datos\run
# Vista en vivo: JPEG por cámara que publica el motor y muestra el panel.
ALPR_WEB_LIVE=C:\alpr\datos\live
ALPR_WEB_LIVE_FPS=3
ALPR_WEB_LIVE_WIDTH=640
ALPR_WEB_LIVE_QUALITY=70
ALPR_WEB_LIVE_MAX_AGE=12

# --- Motor ALPR
# Script, intérprete y .env con los valores comunes a todas las cámaras.
ALPR_WEB_SCRIPT=C:\alpr\alpr_stream.py
ALPR_WEB_PYTHON=C:\alpr\venv\Scripts\python.exe
ALPR_WEB_BASE_ENV=C:\alpr\config\alpr.env

# --- Backend de ejecución
# auto     : systemd si existe, si no supervisor de procesos (lo correcto en Windows)
# proceso  : fuerza el supervisor propio
# systemd  : solo Linux
ALPR_WEB_BACKEND=proceso

# Permite iniciar, detener, reiniciar cámaras y escribir archivos .env desde la web.
ALPR_WEB_ALLOW_CONTROL=true

# Reinicia automáticamente una cámara que muera (equivalente a Restart=always).
ALPR_WEB_AUTORESTART=true
# Límite de reinicios por cámara; 0 = sin límite.
ALPR_WEB_MAX_RESTARTS=0
# Detener las cámaras al cerrar el panel. false = siguen y se reenganchan al volver.
ALPR_WEB_STOP_ON_EXIT=false

# --- Servidor
# 127.0.0.1 solo este PC. Usa 0.0.0.0 únicamente en red interna de confianza.
ALPR_WEB_HOST=127.0.0.1
ALPR_WEB_PORT=8080

# --- Valores por defecto que hereda cada cámara (se pueden sobrescribir por cámara)
# Raíz de datos del motor: las rutas relativas (video\, crops\, live\, placas.csv)
# se resuelven dentro de ella, igual que hace el panel.
ALPR_OUTPUT_DIR=C:\alpr\datos
ALPR_MIN_CONFIDENCE=0.80
ALPR_TARGET_FPS=8
ALPR_DEDUP_WINDOW=5
ALPR_SAVE_CROPS=true
ALPR_SAVE_FULL_FRAME=true
ALPR_HUD=true
# Grabar video anotado. Para no grabarlo: ALPR_NO_VIDEO=true
ALPR_NO_VIDEO=false
# mp4v produce .mp4; si el build de OpenCV no lo trae, usa XVID y ALPR_OUTPUT con .avi
ALPR_FOURCC=mp4v
